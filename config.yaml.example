username: "your_student_or_staff_id"
password: "your_webvpn_password"
proxy:
  # ChatUJN 的 JWT 令牌（形如 eyJhbGciOi...，不是 sk- 开头的 Key）。
  # 取法：登录 ChatUJN → F12 → Network → 任一 POST /api/chat/completions
  #       → 复制请求头 Authorization: Bearer eyJ...，去掉 "Bearer " 前缀。
  # 代理转发时会自动补上 Bearer，所以这里【不要】带前缀。
  api_key: "eyJhbGciOi...粘贴完整的 JWT..."
  # 这一段不用手填：它是主机名的编码（公开常量 wrdvpnisthebest! + AES-CTR），
  # 不是密钥。脚本会用下面的 webvpn_host_query 自动算出来。
  # 想单独查看：uv run python build_litellm_config.py --webvpn-path chat.ujn.edu.cn
  webvpn_api_base: "https://webvpn.ujn.edu.cn/https/<opaque>/api"
  webvpn_host_query: "vpn-12-o2-chat.ujn.edu.cn"
